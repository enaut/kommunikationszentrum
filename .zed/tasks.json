[
  {
    "label": "Start Dioxus",
    "command": "dx serve --package admin --platform web",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "save": "all",
  },
  {
    "label": "Start Grafana",
    "command": "podman-compose down && podman-compose up",
    "cwd": "$ZED_WORKTREE_ROOT/grafana",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "save": "all",
  },
  {
    "label": "Start Sender",
    "command": "sh -lc 'if [ -f .env/.env.webhook-proxy ]; then set -a; . .env/.env.webhook-proxy; set +a; elif [ -f .env ]; then set -a; . .env; set +a; fi; cargo run --package sender'",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "save": "all",
  },
  {
    "label": "Serve Docs",
    "command": "mdbook serve docs --port 3022",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "save": "all",
  },
]
