# Environment configuration for the sender daemon
# Copy to .env/.env.sender or source directly before running: cargo run --package sender
# SMTP auth credentials are configured per category in SpacetimeDB (CategoryAppPassword table).

export SPACETIMEDB_URI="http://127.0.0.1:3000"
export SPACETIMEDB_DATABASE_NAME="kommunikation"
export SPACETIMEDB_TOKEN=""

export SMTP_HOST="127.0.0.1"
export SMTP_PORT="587"
export SMTP_USE_TLS="true"
export SMTP_ACCEPT_INVALID_CERTS="true"
export SMTP_ACCEPT_INVALID_HOSTNAMES="true"

export MAIL_MESSAGE_ID_DOMAIN="localhost"
export MAIL_UNSUBSCRIBE_BASE_URL="http://127.0.0.1:3000/v1/database/kommunikation/route/mailing-list/unsubscribe"

export OTLP_ENDPOINT="http://localhost:4317"
export RUST_LOG="sender=trace"
