# OAuth/OIDC Configuration
# Any standard OpenID Connect provider can be used (e.g. Nextcloud, Keycloak, Authentik, Django)
# Example Nextcloud: https://cloud.example.org/apps/oauth2
# Example Keycloak:  https://auth.example.org/realms/myrealm
# Example Django:    http://127.0.0.1:8000/o
export OIDC_ISSUER_URL="http://127.0.0.1:8000/o"
export OIDC_CLIENT_ID="admin-app"
export ADMIN_REDIRECT_URI="http://127.0.0.1:8080/callback"
export OAUTH_SCOPES="openid profile email"