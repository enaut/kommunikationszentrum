direction: down

account: {
  label: "Account\nid: u64 (PK)\nidentity: Identity\nname: String\nprimary_email_id: u64\nis_active: bool\nlast_synced: i64"
}

account_emails: {
  label: "AccountEmail\nid: u64 (PK, auto_inc)\naccount_id: u64 (FK)\nemail: String (Indexed)\nsource: EmailSource\nis_verified: bool\nadded_at: i64"
}

email_verification_tokens: {
  label: "EmailVerificationToken\ntoken: String (PK)\naccount_id: u64 (FK)\nemail: String\ncreated_at: i64\nexpires_at: i64"
}

account_configs: {
  label: "AccountConfig\naccount_id: u64 (PK, FK)\nmessage_offset: u32\nmessage_limit: u32\nselected_message_topic: Option<u64>\nmember_offset: u32\nmember_limit: u32\nmember_search_query: Option<String>\nviewing_topic_id: Option<u64>\nlanguage: Option<String>\ntheme: Option<String>\nsearch_matching_accounts: u32"
}

system_mail_pending: {
  label: "SystemMailPending\nid: u64 (PK, auto_inc)\nrecipient: String\nsubject: String\nbody_text: String\ninstance_id: Option<String>\nclaimed_at: Option<i64>"
}

mail_message: {
  label: "MailMessage\nid: u64 (PK, auto_inc)\nqueue_id: Option<String>\nreceived_at: Timestamp\nsender_account_id: Option<u64>\nsender_email: String\nsubject: String\nfrom_header: String\nbody_raw: String\nmessage_size: u64"
}

received_message: {
  label: "ReceivedMessage\nid: u64 (PK, auto_inc)\nmail_message_id: u64 (FK)\ntopic_id: u64 (FK)\ntopic_email: String\nreceived_at: Timestamp\ndisposition: MessageDisposition"
}

mail_ingress: {
  label: "MailIngress\nid: u64 (PK, auto_inc)\nmail_message_id: u64 (FK)\ntopic_id: u64 (FK)\ntopic_email: String\nreceived_at: Timestamp"
}

mail_retention_config: {
  label: "MailRetentionConfig\nid: u64 (PK)\nrejected_retention_days: u32\nupdated_at: Timestamp"
}

blocked_ips: {
  label: "BlockedIp\nip: String (PK)\nreason: String\nblocked_at: i64\nactive: bool"
}

message_topics: {
  label: "MessageTopic\nid: u64 (PK, auto_inc)\nname: String\nemail_address: String\ndescription: String\nactive: bool\nvisibility: TopicVisibility\ndefault_permission: SubscriptionPermission"
}

categories: {
  label: "Category\nid: u64 (PK, auto_inc)\nname: String"
}

message_topic_categories: {
  label: "MessageTopicCategory\ntopic_id: u64 (PK, FK)\ncategory_id: u64 (PK, FK)"
}

subscriptions: {
  label: "Subscription\nid: u64 (PK, auto_inc)\nsubscriber_account_id: u64\naccount_email_id: u64 (FK)\ntopic_id: u64 (FK)\nsubscribed_at: i64\nstatus: SubscriptionStatus\npermission: SubscriptionPermission"
}

subscriptions -> message_topics: "topic_id → id" {
  style.stroke: blue
}
message_topic_categories -> message_topics: "topic_id → id" {
  style.stroke: blue
}
message_topic_categories -> categories: "category_id → id" {
  style.stroke: blue
}
subscriptions -> account: "subscriber_account_id → id" {
  style.stroke: blue
  style.stroke-dash: 5
}
account_emails -> account: "account_id → id" {
  style.stroke: blue
}
email_verification_tokens -> account: "account_id → id" {
  style.stroke: blue
}
account_configs -> account: "account_id → id" {
  style.stroke: blue
}
subscriptions -> account_emails: "account_email_id → id" {
  style.stroke: blue
}

received_message -> mail_message: "mail_message_id → id" {
  style.stroke: blue
}
received_message -> message_topics: "topic_id → id" {
  style.stroke: blue
}
mail_ingress -> mail_message: "mail_message_id → id" {
  style.stroke: blue
}
mail_ingress -> message_topics: "topic_id → id" {
  style.stroke: blue
}

mta_processing: "MTA & Retention" {
  style.fill: "#e3f2fd"
  blocked_ips
  received_message
  mail_retention_config
}

topic_mgmt: "Topic & Category Management" {
  style.fill: "#e8f5e9"
  message_topics
  categories
  message_topic_categories
  subscriptions
}

user_mgmt: "User Management" {
  style.fill: "#fffde7"
  account
  account_configs
  account_emails
  email_verification_tokens
}

delivery_mgmt: "Delivery & System Mail" {
  style.fill: "#f3e5f5"
  mail_message
  mail_ingress
  system_mail_pending
}
