direction: right

stages: "MTA Hook Stages" {
  style.fill: "#e0f7fa"
  connect: "CONNECT\nStage"
  ehlo: "EHLO\nStage"
  mail: "MAIL FROM\nStage"
  rcpt: "RCPT TO\nStage"
  data: "DATA\nStage"
  auth: "AUTH\nStage"

  connect -> ehlo -> mail -> rcpt -> data -> auth
}

tables: "Database Tables" {
  style.fill: "#e3f2fd"
  blocked_ips_tbl: "blocked_ips\n• ip (PK)\n• active"
  topics_tbl: "message_topics\n• id (PK)\n• email_address\n• active"
  accounts_tbl: "account\n• id (PK)\n• is_active\n• identity"
  account_emails_tbl: "account_emails\n• account_id (FK)\n• email\n• is_verified"
  subscriptions_tbl: "subscriptions\n• account_email_id (FK)\n• topic_id (FK)\n• permission\n• status"
  mail_msg_tbl: "mail_message\n• id (PK)\n• subject (clean)\n• body_raw"
  received_msg_tbl: "received_message\n• mail_message_id (FK)\n• topic_id (FK)\n• disposition"
  ingress_tbl: "mail_ingress\n• mail_message_id (FK)\n• topic_id (FK)"
  system_mail_tbl: "system_mail_pending\n• recipient\n• rejection notice"
}

logic: "Admission & Routing Logic" {
  style.fill: "#fffde7"
  ip_check: "IP Blocklist\nCheck"
  passthrough: "Pass-Through\n(No DB writes)"
  envelope_topics: "Envelope-Only\nTopic Match"
  admission_eval: "Admission Check\n(Admin OR Active Write Sub,\nSize <= 2MB)"
  final_decision: "Topic\nDisposition" {
    shape: diamond
  }
}

actions: "MTA Actions & Output" {
  style.fill: "#fce4ec"
  accept_passthrough: "ACCEPT\n(Non-topic / Allowed IP)" {
    style.stroke: green
  }
  reject_ip: "REJECT (550)\n(Blocked IP)" {
    style.stroke: red
  }
  stalwart_accept: "ACCEPT in Stalwart\n(With subject suffix if rejected)" {
    style.stroke: green
  }
}

connect -> ip_check
ip_check -> blocked_ips_tbl: "check" { style.stroke: red }
ip_check -> reject_ip: "active block" { style.stroke: red }
ip_check -> accept_passthrough: "allowed" { style.stroke: green }

ehlo -> passthrough: "accept" { style.stroke: green }
mail -> passthrough: "accept (allow <>)" { style.stroke: green }
rcpt -> passthrough: "accept (pass personal mail)" { style.stroke: green }
auth -> passthrough: "accept" { style.stroke: green }

data -> envelope_topics
envelope_topics -> topics_tbl: "match envelope.to" { style.stroke: green }
envelope_topics -> accept_passthrough: "no topics (pass-through)" { style.stroke: green }

envelope_topics -> admission_eval: "topics matched"
admission_eval -> accounts_tbl: "verify active" { style.stroke: green }
admission_eval -> account_emails_tbl: "verify email" { style.stroke: green }
admission_eval -> subscriptions_tbl: "check Write" { style.stroke: green }
admission_eval -> final_decision

final_decision -> ingress_tbl: "enqueue fan-out (Accepted)" { style.stroke: green }
final_decision -> system_mail_tbl: "queue notice (Rejected)" { style.stroke: red }
final_decision -> received_msg_tbl: "store disposition" { style.stroke: blue }
final_decision -> mail_msg_tbl: "store clean msg" { style.stroke: blue }
final_decision -> stalwart_accept: "return response" { style.stroke: green }
