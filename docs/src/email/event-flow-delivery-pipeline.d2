direction: down

pending: "Accepted MailIngress" { style.fill: lightyellow }
schedule: "SpacetimeDB scheduled dispatcher" { style.fill: lightblue }
fanout: "Module fan-out\n• resolve eligible subscriptions\n• compose recipient-specific messages" { style.fill: lightblue }
delivery: "jmap_mail_deliveries\n(durable per-recipient state)" { style.fill: lightyellow }
jmap: "Stalwart JMAP\nupload → import → submit" { style.fill: lightgray }
sent: "Sent\nwith audit event" { style.fill: lightgreen }
retry: "Retryable / uncertain\nwith backoff" { style.fill: lightyellow }
failed: "Permanent failure\nvisible to admins" { style.fill: lightcoral }

pending -> schedule
schedule -> fanout
fanout -> delivery
 delivery -> jmap
jmap -> sent: "success"
jmap -> retry: "transient or uncertain"
jmap -> failed: "permanent error"
retry -> schedule: "next scheduled attempt" { style.stroke-dash: 5 }
