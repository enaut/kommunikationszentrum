direction: down

Schema: {
  account: "Account" {
    shape: sql_table
    id: u64
    primary_email_id: u64
    name: String
    is_active: bool
  }
  account_emails: "AccountEmail" {
    shape: sql_table
    id: u64 (PK)
    account_id: u64 (FK)
    email: String
    source: EmailSource
    is_verified: bool
    added_at: i64
  }
  subscriptions: "Subscription" {
    shape: sql_table
    id: u64 (PK)
    subscriber_account_id: u64 (FK)
    account_email_id: u64 (FK)
    topic_id: u64 (FK)
    subscribed_at: i64
    status: SubscriptionStatus
    permission: SubscriptionPermission
  }
  topics: "MessageTopic" {
    shape: sql_table
    id: u64 (PK)
    name: String
    email_address: String
    description: String
    active: bool
    default_permission: SubscriptionPermission
  }

  account_emails.account_id -> account.id: "account_id → id" {
    style.stroke: blue
  }
  subscriptions.subscriber_account_id -> account.id: "subscriber_account_id → id" {
    style.stroke: blue
  }
  subscriptions.account_email_id -> account_emails.id: "account_email_id → id" {
    style.stroke: blue
  }
  subscriptions.topic_id -> topics.id: "topic_id → id" {
    style.stroke: red
  }
}

example_data: "Example Data (Multi-Email per Account & Category)" {
  style.fill: "#e0f7fa"
  account_example: "Account (Example)" {
    shape: sql_table
    style.fill: lightblue
    id: 1
    primary_email_id: 10
    name: "John Doe"
    is_active: true
  }
  account_email_example: "AccountEmail (Primary)" {
    shape: sql_table
    style.fill: lightblue
    id: 10
    account_id: 1
    email: "user@example.com"
  }
  account_email_example_2: "AccountEmail (Alternative)" {
    shape: sql_table
    style.fill: lightblue
    id: 11
    account_id: 1
    email: "work@example.com"
  }
  subscription_example: "Subscription (Primary Email)" {
    style.fill: lightgreen
    shape: sql_table
    id: 101
    subscriber_account_id: 1
    account_email_id: 10
    topic_id: 1
    subscribed_at: 1672531200
    status: ManuallySubscribed
    permission: Read
  }
  subscription_example_2: "Subscription (Alt Email)" {
    style.fill: lightgreen
    shape: sql_table
    id: 102
    subscriber_account_id: 1
    account_email_id: 11
    topic_id: 1
    subscribed_at: 1672531300
    status: ManuallySubscribed
    permission: Write
  }
  topic_example: "MessageTopic (Example)" {
    shape: sql_table
    style.fill: lightyellow
    id: 1
    name: "SoLaWi News"
    email_address: "news@solawis.de"
    description: "Newsletter"
    active: true
    default_permission: Read
  }

  account_email_example.account_id -> account_example.id: "references" {
    style.stroke: blue
    style.stroke-dash: 5
  }
  account_email_example_2.account_id -> account_example.id: "references" {
    style.stroke: blue
    style.stroke-dash: 5
  }
  subscription_example.subscriber_account_id -> account_example.id: "references" {
    style.stroke: blue
    style.stroke-dash: 5
  }
  subscription_example.account_email_id -> account_email_example.id: "references" {
    style.stroke: blue
    style.stroke-dash: 5
  }
  subscription_example_2.subscriber_account_id -> account_example.id: "references" {
    style.stroke: blue
    style.stroke-dash: 5
  }
  subscription_example_2.account_email_id -> account_email_example_2.id: "references" {
    style.stroke: blue
    style.stroke-dash: 5
  }
  subscription_example.topic_id -> topic_example.id: "references" {
    style.stroke: red
    style.stroke-dash: 5
  }
  subscription_example_2.topic_id -> topic_example.id: "references" {
    style.stroke: red
    style.stroke-dash: 5
  }
}
