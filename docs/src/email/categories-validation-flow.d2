direction: down

incoming_email: "Incoming Email\nTo: recipient@domain.org"
extract_address: "Extract Recipient\nAddress"
lookup_topic: "Lookup in\nmessage_topics" { shape: cylinder }
check_active: "Check if\nTopic Active" { shape: diamond }

accept_email: "ACCEPT\nContinue Processing" {
  style.stroke: green
}
reject_inactive: "REJECT 550\nTopic Inactive" {
  style.stroke: orange
}
reject_unknown: "REJECT 550\nUnknown Recipient" {
  style.stroke: red
}

incoming_email -> extract_address
extract_address -> lookup_topic

lookup_topic -> check_active: "Found"
lookup_topic -> reject_unknown: "Not Found"

check_active -> accept_email: "active=true"
check_active -> reject_inactive: "active=false"

