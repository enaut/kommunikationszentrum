direction: down

incoming_message: "Incoming Message (DATA Stage)\nEnvelope To: topic@solawis.de"
extract_metadata: "Extract Envelope Recipients\n& Sender Address"
topic_match: "Match Envelope.To\nagainst message_topics" { shape: diamond }
non_topic: "Non-Topic Mail\nPass-Through ACCEPT (Zero DB writes)" {
  style.stroke: green
}
admin_check: "Sender has Admin Identity?" { shape: diamond }
sub_check: "Active Account, Verified Email,\nActive Write Subscription?" { shape: diamond }

accepted: "ACCEPTED\n• Add X-Processed-By\n• Queue mail_ingress fan-out\n• Record ReceivedMessage(Accepted)" {
  style.stroke: green
}

rejected: "REJECTED (Per-Topic)\n• Append Subject (rejected from ...)\n• Record ReceivedMessage(Rejected(reason))\n• Queue system rejection notice\n• No mail_ingress fan-out" {
  style.stroke: red
}

incoming_message -> extract_metadata
extract_metadata -> topic_match

topic_match -> non_topic: "No topic matched"
topic_match -> admin_check: "Topic matched"

admin_check -> accepted: "Yes (Admin bypass)"
admin_check -> sub_check: "No"

sub_check -> accepted: "Yes"
sub_check -> rejected: "No (NotRegistered, NotSubscribed,\nNoWritePermission, or Oversize)"
