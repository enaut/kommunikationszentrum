direction: right

categories: "MessageCategory" {
    shape: sql_table
    id: 1
    name: "SoLaWi News"
    email_address: "news@solawis.de"
    active: true
}
subscriptions: "Subscription"{
    shape: sql_table
    id: 101
    category_id: 1
    subscriber_email: "member@example.com"
    active: true
}

subscriptions.category_id -> categories.id: "category_id → id" {
  style.stroke: blue
}
subscribers: "Subscribers" {
  shape: cloud
  style.fill: "#e8f5e9"
  user1: "member@example.com" { shape: oval }
  user2: "volunteer@example.com" { shape: oval }
  user3: "admin@example.com" { shape: oval }
}

subscribers.user1 -> subscriptions: "subscribes to"
subscribers.user2 -> subscriptions: "subscribes to" { style.stroke-dash: 5 }
subscribers.user3 -> subscriptions: "subscribes to" { style.stroke-dash: 5 }
