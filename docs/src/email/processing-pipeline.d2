direction: right

stages: "MTA Hook Stages" {
  style.fill: "#e0f7fa"
  connect: "CONNECT\nStage"
  ehlo: "EHLO\nStage"
  mail: "MAIL FROM\nStage"
  rcpt: "RCPT TO\nStage"
  data: "DATA\nStage"
  auth: "AUTH\nStage"

  connect -> ehlo -> mail -> rcpt -> data -> auth
}

tables: "Database Tables" {
  style.fill: "#e3f2fd"

  blocked_ips_tbl: "blocked_ips" {
    shape: sql_table
    style.fill: darkblue
    ip: "ip (PK)"
    reason: "reason"
    active: "active"
  }

  topics_tbl: "message_topics" {
    shape: sql_table
    style.fill: yellow
    id: "id (PK)"
    name: "name"
    email_address: "email_address"
    active: "active"
  }

  subscriptions_tbl: "subscriptions" {
    shape: sql_table
    style.fill: lavender
    id: "id (PK)"
    account_email_id: "account_email_id"
    topic_id: "topic_id (FK)"
    status: "status"
    permission: "permission"
  }

  received_message_tbl: "received_message" {
    shape: sql_table
    style.fill: lightsalmon
    id: "id (PK)"
    mail_message_id: "mail_message_id (FK)"
    topic_id: "topic_id (FK)"
    disposition: "disposition"
  }

  mail_ingress_tbl: "mail_ingress" {
    shape: sql_table
    style.fill: lightgreen
    id: "id (PK)"
    mail_message_id: "mail_message_id (FK)"
    topic_id: "topic_id (FK)"
  }
}

logic: "Processing Logic" {
  style.fill: "#fffde7"
  ip_check: "IP Blocklist\nCheck"
  passthrough: "Pass-Through\n(Zero DB writes)"
  envelope_check: "Envelope Recipient\nTopic Lookup"
  admission_check: "Admission Check\n(Admin OR Active Write Sub,\nSize <= 2MB)"
  final_decision: "Topic\nDisposition" {
    shape: diamond
  }
}

actions: "Possible Actions" {
  style.fill: "#fce4ec"
  accept_passthrough: "ACCEPT (Pass-Through)\n(Zero modifications/writes)" {
    style.stroke: green
  }
  reject_ip: "REJECT (550)\n(Blocked IP)" {
    style.stroke: red
  }
  stalwart_accept: "ACCEPT in Stalwart\n(Subject modified if rejected)" {
    style.stroke: green
  }
}

stages.connect -> logic.ip_check
logic.ip_check -> tables.blocked_ips_tbl: "lookup" { style.stroke: red }
logic.ip_check -> actions.reject_ip: "active block" { style.stroke: red }
logic.ip_check -> actions.accept_passthrough: "allowed" { style.stroke: green }

stages.ehlo -> logic.passthrough: "accept" { style.stroke: green }
stages.mail -> logic.passthrough: "accept (permits <>)" { style.stroke: green }
stages.rcpt -> logic.passthrough: "accept (pass personal mail)" { style.stroke: green }
stages.auth -> logic.passthrough: "accept" { style.stroke: green }

stages.data -> logic.envelope_check
logic.envelope_check -> tables.topics_tbl: "match envelope.to" { style.stroke: green }
logic.envelope_check -> actions.accept_passthrough: "no topics" { style.stroke: green }

logic.envelope_check -> logic.admission_check: "topic matched"
logic.admission_check -> tables.subscriptions_tbl: "lookup Write sub" { style.stroke: green }
logic.admission_check -> logic.final_decision

logic.final_decision -> tables.received_message_tbl: "record disposition" { style.stroke: blue }
logic.final_decision -> tables.mail_ingress_tbl: "queue fan-out (Accepted)" { style.stroke: green }
logic.final_decision -> actions.stalwart_accept: "return response" { style.stroke: green }
