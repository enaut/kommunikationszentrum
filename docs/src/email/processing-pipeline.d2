direction: right

stages: "MTA Hook Stages" {
  style.fill: "#e0f7fa"
  connect: "CONNECT\nStage"
  ehlo: "EHLO\nStage"
  mail: "MAIL FROM\nStage"
  rcpt: "RCPT TO\nStage"
  data: "DATA\nStage"
  auth: "AUTH\nStage"

  connect -> ehlo -> mail -> rcpt -> data -> auth
}

tables: "Database Tables" {
  style.fill: "#e3f2fd"

  blocked_ips_tbl: "blocked_ips" {
    shape: sql_table
    style.fill: darkblue
    ip: "ip (PK)"
    reason: "reason"
    blocked_at: "blocked_at"
    active: "active"
  }

  mta_conn_log_tbl: "mta_connection_log" {
    shape: sql_table
    style.fill: cyan
    id: "id (PK)"
    client_ip: "client_ip"
    stage: "stage"
    action: "action"
    timestamp: "timestamp"
  }

  mta_msg_log_tbl: "mta_message_log" {
    shape: sql_table
    style.fill: green
    id: "id (PK)"
    from_address: "from_address"
    to_addresses: "to_addresses"
    subject: "subject"
    message_size: "message_size"
  }

  categories_tbl: "message_categories" {
    shape: sql_table
    style.fill: yellow
    id: "id (PK)"
    name: "name"
    email_address: "email_address"
    active: "active"
  }

  subscriptions_tbl: "subscriptions" {
    shape: sql_table
    style.fill: lavender
    id: "id (PK)"
    subscriber_email: "subscriber_email"
    category_id: "category_id (FK)"
    active: "active"
  }
}

logic: "Processing Logic" {
  style.fill: "#fffde7"
  ip_check: "IP Blocking\nCheck"
  email_validation: "Email Format\nValidation"
  category_check: "Category\nValidation"
  subscription_check: "Subscription\nCheck"
  final_decision: "Final\nDecision" {
    shape: diamond
  }
}

actions: "Possible Actions" {
  style.fill: "#fce4ec"
  accept: "ACCEPT" {
    style.stroke: green
  }
  reject: "REJECT" {
    style.stroke: red
  }
  quarantine: "QUARANTINE" {
    style.stroke: orange
  }
}

stages.connect -> logic.ip_check
logic.ip_check -> tables.blocked_ips_tbl: "lookup" { style.stroke: red }
logic.ip_check -> tables.mta_conn_log_tbl: "log result" { style.stroke: blue }


logic.email_validation -> tables.mta_conn_log_tbl: "log result" { style.stroke: blue }

stages.mail -> logic.email_validation

stages.rcpt -> logic.category_check
logic.category_check -> tables.categories_tbl: "lookup" { style.stroke: green }
logic.category_check -> tables.mta_conn_log_tbl: "log result" { style.stroke: blue }

stages.data -> logic.subscription_check
logic.subscription_check -> tables.subscriptions_tbl: "lookup" { style.stroke: green }
logic.subscription_check -> tables.categories_tbl: "lookup" { style.stroke: green }
logic.subscription_check -> logic.final_decision

logic.final_decision -> tables.mta_msg_log_tbl: "log message" { style.stroke: blue }

stages.auth -> tables.mta_conn_log_tbl: "log auth" { style.stroke: blue }

tables.subscriptions_tbl -> tables.categories_tbl: "category_id → id" {
  style.stroke: purple
}

logic.final_decision -> actions.accept: "subscribed" { style.stroke: green }
logic.final_decision -> actions.quarantine: "not subscribed" { style.stroke: orange }
logic.ip_check -> actions.reject: "blocked IP" { style.stroke: red }
logic.email_validation -> actions.reject: "invalid format" { style.stroke: red }
logic.category_check -> actions.reject: "invalid category" { style.stroke: red }
