direction: down

start: "DATA hook received" {
  shape: oval
  style.fill: lightcoral
}
resolve: "Resolve recipients\nto message_categories\n(envelope To -> header To fallback)"
sender: "Look up sender accounts\nby email in account_emails\n(filter active accounts)"
filter: "Authorize categories:\nAdmin identity OR\nActive Write subscription"
reject_notice: "Queue rejection email\nin system_mail_pending\n(via SMTP_SYSTEM_USER)" {
  shape: rectangle
  style.fill: lightpink
}
persist: "For each authorized category:\n• INSERT received_message\n• INSERT mail_ingress (pending)"
resp: "Return accept response\nto Stalwart" {
  shape: oval
  style.fill: lightgreen
}

start -> resolve
resolve -> sender
sender -> filter
filter -> reject_notice: "unauthorized category"
filter -> persist: "≥1 authorized category"
persist -> resp
reject_notice -> resp
