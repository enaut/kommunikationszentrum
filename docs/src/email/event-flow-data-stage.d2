direction: right

MTA: "Stalwart MTA / webhook" { shape: cloud }
Check: "Validate topic, sender,\nsubscription, and size" { shape: diamond }
Message: "mail_message\n(canonical content)" { shape: page }
Ingress: "mail_ingress\n(accepted topic message)" { shape: cylinder }
SystemMail: "system_mail_pending\n(rejection / verification notices)" { shape: cylinder }
JMAP: "Scheduled JMAP dispatcher" { shape: rectangle }

MTA -> Check: "DATA-stage hook"
Check -> Message: "persist message and outcomes"
Message -> Ingress: "accepted topics"
Check -> SystemMail: "rejection notice"
Ingress -> JMAP: "scheduled fan-out and delivery"
SystemMail -> JMAP: "scheduled system-mail delivery"
