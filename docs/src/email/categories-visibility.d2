direction: down

topics: {
  label: "MessageTopics\n• id: u64\n• name: String\n• email_address: String\n• active: bool\n• visibility: TopicVisibility"
}

news_email: "To: news@solawis.de" { shape: oval }
events_email: "To: events@solawis.de" { shape: oval }
invalid_email: "To: invalid@solawis.de" {
  shape: oval
  style.stroke: red
}

accepted: "ACCEPT\n(Valid Topic)" {
  shape: oval
  style.stroke: green
}
rejected: "REJECT\n(Unknown Topic)" {
  shape: oval
  style.stroke: red
}
disabled: "REJECT\n(Inactive Topic)" {
  shape: oval
  style.stroke: orange
}

news_email -> topics: "lookup"
events_email -> topics: "lookup"
invalid_email -> topics: "lookup"

topics -> accepted: "active=true" { style.stroke: green }
topics -> disabled: "active=false" { style.stroke: orange }
topics -> rejected: "not found" { style.stroke: red }

incoming: "Incoming Emails" {
  style.fill: "#e0f7fa"
  news_email
  events_email
  invalid_email
}

results: "Processing Results" {
  style.fill: "#e8f5e9"
  accepted
  rejected
  disabled
}

