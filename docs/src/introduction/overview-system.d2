direction: right

member: "Member / admin" {
  shape: person
  style.fill: "#e8f2ff"
}

admin_ui: "Admin UI\nDioxus / WASM" {
  style.fill: "#dfeeff"
}

django: "Django\nsolawispielplatz\nOAuth + sync" {
  style.fill: "#fff3c6"
}

spacetime: "SpacetimeDB\nmodule + reducers + views" {
  style.fill: "#ffd8d8"
}

stalwart: "Stalwart MTA\nSMTP + JMAP + domains" {
  style.fill: "#eaeaea"
}

sender: "Sender daemon\nSMTP delivery + retries" {
  style.fill: "#dfffe9"
}

relay: "Outbound SMTP\nrelay / recipient" {
  shape: cloud
  style.fill: "#f2ebff"
}

member <-> admin_ui: "subscriptions\nand admin actions"
admin_ui <-> spacetime: "WebSocket updates\nreducer calls"
admin_ui -> django: "OIDC / OAuth"
django -> spacetime: "user sync\ncategories\nsubscriptions"
stalwart -> spacetime: "MTA hooks\nmail ingress"
stalwart <-> spacetime: "domain sync\nmailbox state"
spacetime -> sender: "pending deliveries\nfan-out jobs"
sender -> stalwart: "submission via\ncategory app passwords"
sender -> relay: "outbound SMTP delivery"
spacetime -> sender: "retry queue\ntransient failures"
