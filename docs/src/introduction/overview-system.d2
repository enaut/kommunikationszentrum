direction: right

member: "Member / admin" {
  shape: person
  style.fill: "#e8f2ff"
}

admin_ui: "Admin UI\nDioxus / WASM" {
  style.fill: "#dfeeff"
}

django: "Django\nsolawispielplatz\nOAuth + sync" {
  style.fill: "#fff3c6"
}

spacetime: "SpacetimeDB\nmodule + reducers + scheduled delivery" {
  style.fill: "#ffd8d8"
}

stalwart: "Stalwart MTA\nSMTP + JMAP + domains" {
  style.fill: "#eaeaea"
}

member <-> admin_ui: "subscriptions\nand admin actions"
admin_ui <-> spacetime: "WebSocket updates\nreducer calls"
admin_ui -> django: "OIDC / OAuth"
django -> spacetime: "user sync\ntopics\nsubscriptions"
stalwart -> spacetime: "MTA hooks\nmail ingress"
stalwart <-> spacetime: "domain sync\nmailbox state"
spacetime -> stalwart: "scheduled JMAP\ndelivery + retry"
