direction: right

"Private Tables": {
  style.fill: "#edf2ff"
  account
  admin_identities
  webhook_tokens
  stalwart_config
  message_categories
  topics
  message_category_topics
  subscriptions
  subscription_unsubscribe_tokens
  category_app_passwords
  domains
  received_message
  mail_message
  mail_ingress
  mail_delivery_message
  mail_delivery_pending
  mail_delivery_temporary_failed
  mail_delivery_claimed
  mail_delivery_done
  mail_delivery_events
}

"Member / Admin Views": {
  style.fill: "#dcfce7"

  visible_accounts: |md
    ### visible_accounts
    * Admin sees all rows.
    * Member sees only their own row.
  | {
    shape: rectangle
    style.fill: "#e3f2fd"
  }

  visible_admin_identities: |md
    ### visible_admin_identities
    * Admin-only authorization view.
  | {
    shape: rectangle
    style.fill: "#e3f2fd"
  }

  visible_webhook_tokens: |md
    ### visible_webhook_tokens
    * Admin-only token management view.
  | {
    shape: rectangle
    style.fill: "#e3f2fd"
  }

  admin_stalwart_config: |md
    ### admin_stalwart_config
    * Admin-only Stalwart JMAP URL and credential configuration view.
  | {
    shape: rectangle
    style.fill: "#e3f2fd"
  }

  visible_domains: |md
    ### visible_domains
    * Admin-only domain inventory view.
  | {
    shape: rectangle
    style.fill: "#e3f2fd"
  }

  visible_message_categories: |md
    ### visible_message_categories
    * Public categories visible to all members.
    * Private categories require admin or subscription.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  visible_topics: |md
    ### visible_topics
    * Public topic tags.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  visible_message_category_topics: |md
    ### visible_message_category_topics
    * Public category-topic assignments.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  visible_subscriptions: |md
    ### visible_subscriptions
    * Member sees own subscriptions only.
    * Admin sees all rows.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  active_subscriptions: |md
    ### active_subscriptions
    * Admin-only active subscription fan-out list.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  active_unsubscribe_tokens: |md
    ### active_unsubscribe_tokens
    * Admin-only active unsubscribe tokens.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  visible_category_app_passwords: |md
    ### visible_category_app_passwords
    * Admin-only SMTP app-password metadata.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  visible_messages: |md
    ### visible_messages
    * Admin sees all rows.
    * Member sees only subscribed categories.
  | {
    shape: rectangle
    style.fill: "#fff3e0"
  }
}

"Sender Worker Views": {
  style.fill: "#fef3c7"

  sender_mail_messages: |md
    ### sender_mail_messages
    * Admin-only raw message bodies and headers.
  | {
    shape: rectangle
    style.fill: "#f3e5f5"
  }

  sender_mail_ingress: |md
    ### sender_mail_ingress
    * Admin-only ingress queue for the sender daemon.
  | {
    shape: rectangle
    style.fill: "#f3e5f5"
  }

  sender_mail_delivery_messages: |md
    ### sender_mail_delivery_messages
    * Admin-only outbound per-recipient message bodies & envelopes.
  | {
    shape: rectangle
    style.fill: "#f3e5f5"
  }

  sender_mail_delivery_pending: |md
    ### sender_mail_delivery_pending
    * Current outbound work queue.
  | {
    shape: rectangle
    style.fill: "#f3e5f5"
  }

  sender_mail_delivery_claimed: |md
    ### sender_mail_delivery_claimed
    * Active lease-bound work.
  | {
    shape: rectangle
    style.fill: "#f3e5f5"
  }

  sender_mail_delivery_done: |md
    ### sender_mail_delivery_done
    * Terminal delivery audit rows.
  | {
    shape: rectangle
    style.fill: "#f3e5f5"
  }

  sender_mail_delivery_events: |md
    ### sender_mail_delivery_events
    * Immutable attempt and SMTP logs.
  | {
    shape: rectangle
    style.fill: "#f3e5f5"
  }

  sender_mail_delivery_temporary_failed: |md
    ### sender_mail_delivery_temporary_failed
    * Retry queue for transient SMTP failures.
  | {
    shape: rectangle
    style.fill: "#f3e5f5"
  }
}

"Private Tables".account -> "Member / Admin Views".visible_accounts
"Private Tables".admin_identities -> "Member / Admin Views".visible_admin_identities
"Private Tables".webhook_tokens -> "Member / Admin Views".visible_webhook_tokens
"Private Tables".stalwart_config -> "Member / Admin Views".admin_stalwart_config
"Private Tables".domains -> "Member / Admin Views".visible_domains
"Private Tables".message_categories -> "Member / Admin Views".visible_message_categories
"Private Tables".topics -> "Member / Admin Views".visible_topics
"Private Tables".message_category_topics -> "Member / Admin Views".visible_message_category_topics
"Private Tables".subscriptions -> "Member / Admin Views".visible_subscriptions
"Private Tables".subscriptions -> "Member / Admin Views".active_subscriptions
"Private Tables".subscription_unsubscribe_tokens -> "Member / Admin Views".active_unsubscribe_tokens
"Private Tables".category_app_passwords -> "Member / Admin Views".visible_category_app_passwords
"Private Tables".received_message -> "Member / Admin Views".visible_messages
"Private Tables".mail_message -> "Sender Worker Views".sender_mail_messages
"Private Tables".mail_ingress -> "Sender Worker Views".sender_mail_ingress
"Private Tables".mail_delivery_message -> "Sender Worker Views".sender_mail_delivery_messages
"Private Tables".mail_delivery_pending -> "Sender Worker Views".sender_mail_delivery_pending
"Private Tables".mail_delivery_claimed -> "Sender Worker Views".sender_mail_delivery_claimed
"Private Tables".mail_delivery_done -> "Sender Worker Views".sender_mail_delivery_done
"Private Tables".mail_delivery_events -> "Sender Worker Views".sender_mail_delivery_events
"Private Tables".mail_delivery_temporary_failed -> "Sender Worker Views".sender_mail_delivery_temporary_failed
