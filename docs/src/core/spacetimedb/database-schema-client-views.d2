direction: right

"Private Tables": {
  style.fill: "#edf2ff"
  account
  account_configs
  account_emails
  admin_identities
  webhook_tokens
  stalwart_config
  message_topics
  categories
  message_topic_categories
  subscriptions
  subscription_unsubscribe_tokens
  topic_app_passwords
  domains
  received_message
  mail_message
  mail_ingress
  mail_delivery_message
  mail_delivery_pending
  mail_delivery_temporary_failed
  mail_delivery_claimed
  mail_delivery_done
  mail_delivery_events
  system_mail_pending
  email_verification_tokens
}

"Member / Admin Views": {
  style.fill: "#dcfce7"

  visible_accounts: |md
    ### visible_accounts
    * Admin sees all rows.
    * Member sees only their own row.
  | {
    shape: rectangle
    style.fill: "#e3f2fd"
  }

  visible_account_configs: |md
    ### visible_account_configs
    * Config for user UI state and pagination.
    * Member sees only their own config.
  | {
    shape: rectangle
    style.fill: "#e3f2fd"
  }

  visible_admin_identities: |md
    ### visible_admin_identities
    * Admin-only authorization view.
  | {
    shape: rectangle
    style.fill: "#e3f2fd"
  }

  visible_account_emails: |md
    ### visible_account_emails
    * Admin sees all rows.
    * Member sees only their own emails.
  | {
    shape: rectangle
    style.fill: "#e3f2fd"
  }

  visible_webhook_tokens: |md
    ### visible_webhook_tokens
    * Admin-only token management view.
  | {
    shape: rectangle
    style.fill: "#e3f2fd"
  }

  admin_stalwart_config: |md
    ### admin_stalwart_config
    * Admin-only Stalwart JMAP URL and credential configuration view.
  | {
    shape: rectangle
    style.fill: "#e3f2fd"
  }

  visible_domains: |md
    ### visible_domains
    * Admin-only domain inventory view.
  | {
    shape: rectangle
    style.fill: "#e3f2fd"
  }

  visible_message_topics: |md
    ### visible_message_topics
    * Public topics visible to all members.
    * Private topics require admin or subscription.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  visible_categories: |md
    ### visible_categories
    * Public category tags.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  visible_message_topic_categories: |md
    ### visible_message_topic_categories
    * Public topic-category assignments.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  visible_subscriptions: |md
    ### visible_subscriptions
    * Member sees own subscriptions only.
    * Admin sees all rows.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  active_subscriptions: |md
    ### active_subscriptions
    * Admin-only active subscription fan-out list.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  active_unsubscribe_tokens: |md
    ### active_unsubscribe_tokens
    * Admin-only active unsubscribe tokens.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  visible_topic_app_passwords: |md
    ### visible_topic_app_passwords
    * Admin-only SMTP app-password metadata.
  | {
    shape: rectangle
    style.fill: "#e8f5e9"
  }

  visible_messages: |md
    ### visible_messages
    * Admin sees all rows.
    * Member sees only subscribed topics.
  | {
    shape: rectangle
    style.fill: "#fff3e0"
  }

  visible_mail_messages: |md
    ### visible_mail_messages
    * Paginated message bodies and headers for the visible messages page.
  | {
    shape: rectangle
    style.fill: "#fff3e0"
  }

  total_accounts: |md
    ### total_accounts
    * Public anonymous view.
    * Constant-time total registered accounts count.
  | {
    shape: rectangle
    style.fill: "#fff3e0"
  }

  topic_message_counts: |md
    ### topic_message_counts
    * Public view.
    * Real-time received message counts per topic.
  | {
    shape: rectangle
    style.fill: "#fff3e0"
  }

  topic_subscriber_counts: |md
    ### topic_subscriber_counts
    * Public view.
    * Real-time active subscriber counts per topic.
  | {
    shape: rectangle
    style.fill: "#fff3e0"
  }
}

"JMAP Delivery Views": {
  style.fill: "#fef3c7"

  sender_jmap_mail_deliveries: |md
    ### sender_jmap_mail_deliveries
    * Administrator-filtered JMAP delivery state for the status page.
  | {
    shape: rectangle
    style.fill: "#f3e5f5"
  }

  sender_jmap_mail_delivery_events: |md
    ### sender_jmap_mail_delivery_events
    * Administrator-filtered JMAP delivery events.
  | {
    shape: rectangle
    style.fill: "#f3e5f5"
  }
}

"Private Tables".account -> "Member / Admin Views".visible_accounts
"Private Tables".account_configs -> "Member / Admin Views".visible_account_configs
"Private Tables".account_emails -> "Member / Admin Views".visible_account_emails
"Private Tables".admin_identities -> "Member / Admin Views".visible_admin_identities
"Private Tables".webhook_tokens -> "Member / Admin Views".visible_webhook_tokens
"Private Tables".stalwart_config -> "Member / Admin Views".admin_stalwart_config
"Private Tables".domains -> "Member / Admin Views".visible_domains
"Private Tables".message_topics -> "Member / Admin Views".visible_message_topics
"Private Tables".categories -> "Member / Admin Views".visible_categories
"Private Tables".message_topic_categories -> "Member / Admin Views".visible_message_topic_categories
"Private Tables".subscriptions -> "Member / Admin Views".visible_subscriptions
"Private Tables".subscriptions -> "Member / Admin Views".active_subscriptions
"Private Tables".subscription_unsubscribe_tokens -> "Member / Admin Views".active_unsubscribe_tokens
"Private Tables".topic_app_passwords -> "Member / Admin Views".visible_topic_app_passwords
"Private Tables".received_message -> "Member / Admin Views".visible_messages
"Private Tables".mail_message -> "Member / Admin Views".visible_mail_messages
"Private Tables".account -> "Member / Admin Views".total_accounts
"Private Tables".received_message -> "Member / Admin Views".topic_message_counts
"Private Tables".subscriptions -> "Member / Admin Views".topic_subscriber_counts
"Private Tables".jmap_mail_deliveries -> "JMAP Delivery Views".sender_jmap_mail_deliveries
"Private Tables".jmap_mail_delivery_events -> "JMAP Delivery Views".sender_jmap_mail_delivery_events

