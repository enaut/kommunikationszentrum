direction: down

"Client & Integration Callers": {
  AdminUI: {
    shape: person
    label: "Admin UI Client"
  }
  UserClient: {
    shape: person
    label: "Member Client"
  }
  MTAHook: {
    shape: cloud
    label: "Stalwart MTA Hook (HTTP)"
  }
  DjangoWebhook: {
    shape: cloud
    label: "Django Sync Webhook (HTTP)"
  }

}

"SpacetimeDB Reducers & Procedures": {
  "Auth & Identity": {
    register_admin_identity
    unregister_admin_identity
    create_webhook_token
    revoke_webhook_token
    sync_user
    set_stalwart_config
  }

  "Topic & Category Management": {
    add_message_topic
    update_message_topic
    remove_message_topic
    set_topic_categories
    rename_category
    add_and_subscribe_topic
    provision_message_topic: "Procedure (JMAP + app password)"
    sync_stalwart_domains: "Procedure (JMAP sync)"
  }

  "Subscription Flow": {
    add_subscription
    admin_add_subscription
    remove_subscription
    ensure_subscription_unsubscribe_token
  }

  "MTA Retention": {
    set_mail_retention_config
    purge_rejected_mails: "Scheduled"
  }

  "Native JMAP Delivery": {
    dispatch_jmap_mail: "Scheduled procedure"
    retry_failed_jmap_delivery: "Admin reducer"
    migrate_pending_legacy_deliveries: "Admin procedure"
  }
}

"Database Tables": {
  account
  admin_identities
  webhook_tokens
  stalwart_config
  message_topics
  topic_app_passwords
  categories
  message_topic_categories
  subscriptions
  subscription_unsubscribe_tokens
  domains
  mail_retention_config
  purge_rejected_mails_schedule
  blocked_ips
  received_message
  mail_message
  mail_ingress
  system_mail_pending
  jmap_mail_deliveries
  jmap_mail_delivery_events
  jmap_mail_dispatch_schedule
}

"Legacy SMTP Queue Tables": {
  mail_delivery_message
  mail_delivery_pending
  mail_delivery_temporary_failed
  mail_delivery_claimed
  mail_delivery_done
  mail_delivery_events
}

"Client & Integration Callers".AdminUI -> "SpacetimeDB Reducers & Procedures"."Auth & Identity": "Admin actions & config"
"Client & Integration Callers".AdminUI -> "SpacetimeDB Reducers & Procedures"."Topic & Category Management": "Manage topics & categories"
"Client & Integration Callers".AdminUI -> "SpacetimeDB Reducers & Procedures"."MTA Retention": "Configure retention"
"Client & Integration Callers".AdminUI -> "SpacetimeDB Reducers & Procedures"."Native JMAP Delivery".retry_failed_jmap_delivery: "Manual retry"
"Client & Integration Callers".AdminUI -> "SpacetimeDB Reducers & Procedures"."Native JMAP Delivery".migrate_pending_legacy_deliveries: "Legacy queue migration"

"Client & Integration Callers".UserClient -> "SpacetimeDB Reducers & Procedures"."Subscription Flow".add_subscription: "User opt-in"

"Client & Integration Callers".DjangoWebhook -> "SpacetimeDB Reducers & Procedures"."Auth & Identity".sync_user: "User / topic sync"

"SpacetimeDB Reducers & Procedures"."Native JMAP Delivery" -> "Database Tables": "scheduled JMAP dispatch and durable delivery state"
"SpacetimeDB Reducers & Procedures"."Native JMAP Delivery".migrate_pending_legacy_deliveries -> "Legacy SMTP Queue Tables": "migrate unclaimed pending rows"

"SpacetimeDB Reducers & Procedures" -> "Database Tables": "Transactional mutation"
