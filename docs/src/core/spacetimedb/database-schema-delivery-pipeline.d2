direction: right

MTA: {
  shape: cloud
  label: "Stalwart MTA / Webhook"
}

Ingress: {
  shape: class
  label: "mail_ingress [Private]\n(1 per category email)"
  claim: "pending | processing | retry_scheduled | completed | failed"
  lease: "claim_owner, instance_id & claim_expires_at (10 min)"
}

FanOut: {
  shape: diamond
  label: "Fan-Out Engine\n(Sender Daemon)"
}

Pending: {
  shape: class
  label: "mail_delivery_pending [Private]\n(Queued for SMTP delivery)"
  keys: "id (ingress:sub:email), next_attempt_at"
}

Claimed: {
  shape: class
  label: "mail_delivery_claimed [Private]\n(Active Worker Lease)"
  lease: "worker, instance_id & lease_expires_at (5 min)"
}

Done: {
  shape: class
  label: "mail_delivery_done [Private]\n(Terminal records)"
  state: "sent | failed | bounced"
}

Audit: {
  shape: page
  label: "mail_delivery_events [Private]\n(Immutable audit trail)"
}

MTA -> Ingress: "POST /mta-hook (DATA stage)"
Ingress -> FanOut: "Claim ingress lease"
FanOut -> Pending: "enqueue_mail_delivery()"
Pending -> Claimed: "claim_next_mail_delivery()"
Claimed -> Done: "mark_sent() / fail() / bounce()"
Claimed -> Audit: "Log attempt & SMTP response"
Claimed -> Pending: "schedule_retry() / lease_expired" { style.stroke-dash: 5 }
