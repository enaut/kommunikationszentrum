direction: right

MTA: {
  shape: cloud
  label: "Stalwart MTA / webhook"
}

MailMessage: {
  shape: page
  label: "mail_message [Private]"
  purpose: "Canonical inbound content"
}

Ingress: {
  shape: class
  label: "mail_ingress [Private]"
  state: "pending | processing | retry_scheduled | completed | failed"
}

FanOut: {
  shape: diamond
  label: "Scheduled SpacetimeDB procedure\nrecipient fan-out"
}

Delivery: {
  shape: class
  label: "jmap_mail_deliveries [Private]"
  state: "pending | importing | imported | submitting | submission_unknown | sent | failed"
  fields: "recipient, claim, retry, JMAP IDs"
}

Events: {
  shape: page
  label: "jmap_mail_delivery_events [Private]"
  audit: "JMAP lifecycle outcomes"
}

StalwartJMAP: {
  shape: cloud
  label: "Stalwart JMAP API"
}

Legacy: {
  shape: class
  label: "Legacy SMTP queue [Private]"
  purpose: "Migration and reconciliation only"
}

MTA -> MailMessage: "mail hook"
MailMessage -> Ingress: "accepted topic message"
Ingress -> FanOut: "scheduled dispatch"
FanOut -> Delivery: "one row per recipient"
Delivery -> StalwartJMAP: "upload, import, submit"
Delivery -> Events: "audit events"
Legacy -> Delivery: "migrate unclaimed pending rows"
