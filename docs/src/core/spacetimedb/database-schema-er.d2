direction: down
"User Management & Auth": {
  style.fill: "#eef2f7"

  account: {
    shape: sql_table
    label: "account [Private]"
    id: "u64 (PK)"
    identity: "Identity (UQ)"
    email: "String (BTree)"
    name: "String"
    is_active: "bool"
    last_synced: "Timestamp (BTree)"
  }

  admin_identities: {
    shape: sql_table
    label: "admin_identities [Private]"
    identity: "Identity (PK)"
  }

  webhook_tokens: {
    shape: sql_table
    label: "webhook_tokens [Private]"
    id: "u64 (PK, auto_inc)"
    token_hash: "String (UQ)"
    "label": "String"
    permissions: "Vec<String>"
    created_at: "Timestamp (BTree)"
    active: "bool"
  }
}

"Mailing & Subscriptions": {
  style.fill: "#e8f5e9"

  message_categories: {
    shape: sql_table
    label: "message_categories [Private]"
    id: "u64 (PK, auto_inc)"
    email_address: "String (UQ)"
    name: "String"
    description: "String"
    active: "bool"
    visibility: "CategoryVisibility (BTree)"
  }

  topics: {
    shape: sql_table
    label: "topics [Private]"
    id: "u64 (PK, auto_inc)"
    name: "String (UQ)"
  }

  message_category_topics: {
    shape: sql_table
    label: "message_category_topics [Private]"
    id: "u64 (PK, auto_inc)"
    category_id: "u64 (BTree)"
    topic_id: "u64 (BTree)"
  }

  subscriptions: {
    shape: sql_table
    label: "subscriptions [Private]"
    id: "u64 (PK, auto_inc)"
    subscriber_account_id: "u64 (BTree)"
    subscriber_email: "String (BTree)"
    category_id: "u64 (BTree)"
    subscribed_at: "Timestamp"
    status: "SubscriptionStatus (BTree)"
  }

  subscription_unsubscribe_tokens: {
    shape: sql_table
    label: "subscription_unsubscribe_tokens [Private]"
    token: "String (PK)"
    subscription_id: "u64 (UQ)"
    created_at: "Timestamp (BTree)"
    active: "bool"
    revoked_at: "Timestamp"
  }
}

"MTA Audit & Processing": {
  style.fill: "#fff3e0"

  mta_connection_log: {
    shape: sql_table
    label: "mta_connection_log [Private]"
    id: "u64 (PK, auto_inc)"
    client_ip: "String"
    stage: "String"
    action: "String"
    timestamp: "Timestamp"
    details: "String"
  }

  mta_message_log: {
    shape: sql_table
    label: "mta_message_log [Private]"
    id: "u64 (PK, auto_inc)"
    from_address: "String"
    to_addresses: "String (JSON)"
    subject: "String"
    message_size: "u64"
    stage: "String"
    action: "String"
    timestamp: "Timestamp"
    queue_id: "Option<String>"
  }

  received_message: {
    shape: sql_table
    label: "received_message [Private]"
    id: "u64 (PK, auto_inc)"
    queue_id: "Option<String>"
    received_at: "Timestamp (BTree)"
    sender_account_id: "Option<u64>"
    sender_email: "String"
    category_id: "u64 (BTree)"
    category_email: "String"
    subject: "String"
    from_header: "String"
    date_header: "Option<String>"
    message_id: "Option<String>"
    reply_to: "Option<String>"
    cc_header: "Option<String>"
    headers_raw: "String (JSON)"
    body_raw: "String"
    message_size: "u64"
  }

  blocked_ips: {
    shape: sql_table
    label: "blocked_ips [Private]"
    ip: "String" {constraint: primary_key}
    reason: "String"
    blocked_at: "Timestamp"
    active: "bool"
  }
}

"Delivery Pipeline": {
  style.fill: "#f3e5f5"

  mail_ingress: {
    shape: sql_table
    label: "mail_ingress [Private]"
    id: "String (PK)"
    queue_id: "String (BTree)"
    category_id: "u64 (BTree)"
    state: "String (BTree)"
    next_attempt_at: "Timestamp (BTree)"
    received_at: "Timestamp (BTree)"
    sender_account_id: "Option<u64>"
    sender_email: "String"
    category_email: "String"
    subject: "String"
    from_header: "String"
    reply_to: "Option<String>"
    date_header: "Option<String>"
    message_id: "Option<String>"
    cc_header: "Option<String>"
    headers_raw: "String (JSON)"
    body_raw: "String"
    message_size: "u64"
    claim_owner: "Option<Identity>"
    claim_expires_at: "Timestamp"
    attempt_count: "u32"
    recipient_count: "u32"
    delivery_count: "u32"
    failed_delivery_count: "u32"
    last_error: "Option<String>"
    completed_at: "Timestamp"
    updated_at: "Timestamp"
  }

  mail_deliveries: {
    shape: sql_table
    label: "mail_deliveries [Private]"
    id: "String (PK)"
    ingress_id: "String (BTree)"
    category_id: "u64 (BTree)"
    subscription_id: "u64 (BTree)"
    recipient_email: "String (BTree)"
    state: "String (BTree)"
    next_attempt_at: "Timestamp (BTree)"
    recipient_account_id: "Option<u64>"
    list_email: "String"
    list_name: "String"
    original_sender_email: "String"
    from_header: "String"
    reply_to: "String"
    subject: "String"
    body_raw: "String"
    headers_raw: "String (JSON)"
    raw_message: "String"
    unsubscribe_token: "String"
    claim_owner: "Option<Identity>"
    claim_expires_at: "Timestamp"
    attempt_count: "u32"
    sent_at: "Timestamp"
    last_error: "Option<String>"
    smtp_status_code: "Option<u16>"
    smtp_response: "Option<String>"
    updated_at: "Timestamp"
  }

  mail_delivery_events: {
    shape: sql_table
    label: "mail_delivery_events [Private]"
    id: "u64 (PK, auto_inc)"
    delivery_id: "String (BTree)"
    occurred_at: "Timestamp (BTree)"
    event_type: "String"
    attempt_no: "u32"
    smtp_status_code: "Option<u16>"
    smtp_response: "Option<String>"
    error_kind: "Option<String>"
    details: "String"
    worker_identity: "Option<Identity>"
  }
}

# Key Foreign Keys & Relationships
"User Management & Auth".admin_identities.identity -> "User Management & Auth".account.identity

"Mailing & Subscriptions".subscriptions.subscriber_account_id -> "User Management & Auth".account.id
"Mailing & Subscriptions".subscriptions.category_id -> "Mailing & Subscriptions".message_categories.id
"Mailing & Subscriptions".subscription_unsubscribe_tokens.subscription_id -> "Mailing & Subscriptions".subscriptions.id
"Mailing & Subscriptions".message_category_topics.category_id -> "Mailing & Subscriptions".message_categories.id
"Mailing & Subscriptions".message_category_topics.topic_id -> "Mailing & Subscriptions".topics.id

"Delivery Pipeline".mail_ingress.category_id -> "Mailing & Subscriptions".message_categories.id
"Delivery Pipeline".mail_ingress.sender_account_id -> "User Management & Auth".account.id
"Delivery Pipeline".mail_deliveries.ingress_id -> "Delivery Pipeline".mail_ingress.id
"Delivery Pipeline".mail_deliveries.category_id -> "Mailing & Subscriptions".message_categories.id
"Delivery Pipeline".mail_deliveries.subscription_id -> "Mailing & Subscriptions".subscriptions.id
"Delivery Pipeline".mail_delivery_events.delivery_id -> "Delivery Pipeline".mail_deliveries.id
"MTA Audit & Processing".received_message.sender_account_id -> "User Management & Auth".account.id
"MTA Audit & Processing".received_message.category_id -> "Mailing & Subscriptions".message_categories.id
