direction: down
# Constraints legend: primary_key -> PK, foreign_key -> FK, unique -> UNQ, BTree -> index, INC -> auto-increment
# Multiple constraints are specified as a semicolon-separated list inside brackets.
# Example: category_id: "u64" {constraint: [foreign_key; BTree]}
# Use INC for auto-increment columns: id: "u64" {constraint: [primary_key; INC]}

"User Management & Auth": {
  style.fill: "#eef2f7"

  account: {
    shape: sql_table
    label: "account [Private]"
    id: "u64" {constraint: primary_key}
    identity: "Identity" {constraint: unique}
    email: "String" {constraint: BTree}
    name: "String"
    is_active: "bool"
    last_synced: "Timestamp" {constraint: BTree}
  }

  admin_identities: {
    shape: sql_table
    label: "admin_identities [Private]"
    identity: "Identity" {constraint: [primary_key; foreign_key; BTree]}
  }

  webhook_tokens: {
    shape: sql_table
    label: "webhook_tokens [Private]"
    id: "u64" {constraint: [primary_key; INC]}
    token_hash: "String" {constraint: unique}
    "label": "String"
    permissions: "Vec<String>"
    created_at: "Timestamp" {constraint: BTree}
    active: "bool"
  }
}

"Mailing & Subscriptions": {
  style.fill: "#e8f5e9"

  message_categories: {
    shape: sql_table
    label: "message_categories [Private]"
    id: "u64" {constraint: [primary_key; INC]}
    email_address: "String" {constraint: unique}
    name: "String"
    description: "String"
    active: "bool"
    visibility: "CategoryVisibility" {constraint: BTree}
  }

  topics: {
    shape: sql_table
    label: "topics [Private]"
    id: "u64" {constraint: [primary_key; INC]}
    name: "String" {constraint: unique}
  }

  message_category_topics: {
    shape: sql_table
    label: "message_category_topics [Private]"
    id: "u64" {constraint: [primary_key; INC]}
    category_id: "u64" {constraint: [foreign_key; BTree]}
    topic_id: "u64" {constraint: [foreign_key; BTree]}
  }

  subscriptions: {
    shape: sql_table
    label: "subscriptions [Private]"
    id: "u64" {constraint: [primary_key; INC]}
    subscriber_account_id: "u64" {constraint: [foreign_key; BTree]}
    subscriber_email: "String" {constraint: BTree}
    category_id: "u64" {constraint: [foreign_key; BTree]}
    subscribed_at: "Timestamp"
    status: "SubscriptionStatus" {constraint: BTree}
  }

  subscription_unsubscribe_tokens: {
    shape: sql_table
    label: "subscription_unsubscribe_tokens [Private]"
    token: "String" {constraint: primary_key}
    subscription_id: "u64" {constraint: [unique; foreign_key; BTree]}
    created_at: "Timestamp" {constraint: BTree}
    active: "bool"
    revoked_at: "Timestamp"
  }
}

"MTA Audit & Processing": {
  style.fill: "#fff3e0"

  mail_message: {
    shape: sql_table
    label: "mail_message [Private]"
    id: "u64" {constraint: [primary_key; INC]}
    queue_id: "Option<String>"
    received_at: "Timestamp"
    sender_account_id: "Option<u64>" {constraint: [foreign_key]}
    sender_email: "String"
    subject: "String"
    from_header: "String"
    reply_to: "Option<String>"
    date_header: "Option<String>"
    message_id: "Option<String>"
    cc_header: "Option<String>"
    headers_raw: "String (JSON)"
    body_raw: "String"
    message_size: "u64"
  }

  mta_message_log: {
    shape: sql_table
    label: "mta_message_log [Private]"
    id: "u64" {constraint: [primary_key; INC]}
    stage: "String"
    action: "String"
    timestamp: "Timestamp"
    queue_id: "Option<String>"
    category_count: "u32"
  }

  received_message: {
    shape: sql_table
    label: "received_message [Private]"
    id: "u64" {constraint: [primary_key; INC]}
    mail_message_id: "u64" {constraint: [foreign_key; BTree]}
    category_id: "u64" {constraint: [foreign_key; BTree]}
    category_email: "String"
    received_at: "Timestamp" {constraint: BTree}
  }

  blocked_ips: {
    shape: sql_table
    label: "blocked_ips [Private]"
    ip: "String" {constraint: primary_key}
    reason: "String"
    blocked_at: "Timestamp"
    active: "bool"
  }
}

"Delivery Pipeline": {
  style.fill: "#f3e5f5"

  mail_ingress: {
    shape: sql_table
    label: "mail_ingress [Private]"
    id: "String" {constraint: primary_key}
    mail_message_id: "u64" {constraint: [foreign_key; BTree]}
    category_id: "u64" {constraint: [foreign_key; BTree]}
    category_email: "String"
    claim: "ClaimState"
    recipient_count: "u32"
    delivery_count: "u32"
    failed_delivery_count: "u32"
    completed_at: "Timestamp"
  }

  mail_delivery_pending: {
    shape: sql_table
    label: "mail_delivery_pending [Private]"
    id: "String" {constraint: primary_key}
    ingress_id: "String" {constraint: [foreign_key; BTree]}
    next_attempt_at: "Timestamp" {constraint: BTree}
    row: "MailDeliveryRow"
  }

  mail_delivery_claimed: {
    shape: sql_table
    label: "mail_delivery_claimed [Private]"
    id: "String" {constraint: primary_key}
    worker: "Identity"
    instance_id: "String"
    lease_expires_at: "Timestamp" {constraint: BTree}
    row: "MailDeliveryRow"
  }

  mail_delivery_done: {
    shape: sql_table
    label: "mail_delivery_done [Private]"
    id: "String" {constraint: primary_key}
    ingress_id: "String" {constraint: [foreign_key; BTree]}
    final_state: "String"
    row: "MailDeliveryRow"
  }

  mail_delivery_events: {
    shape: sql_table
    label: "mail_delivery_events [Private]"
    id: "u64" {constraint: [primary_key; INC]}
    delivery_id: "String" {constraint: [foreign_key; BTree]}
    occurred_at: "Timestamp" {constraint: BTree}
    event_type: "String"
    attempt_no: "u32"
    smtp_status_code: "Option<u16>"
    smtp_response: "Option<String>"
    error_kind: "Option<String>"
    details: "String"
    worker_identity: "Option<Identity>"
  }
}

# Key Foreign Keys & Relationships
"User Management & Auth".admin_identities.identity -> "User Management & Auth".account.identity

"Mailing & Subscriptions".subscriptions.subscriber_account_id -> "User Management & Auth".account.id
"Mailing & Subscriptions".subscriptions.category_id -> "Mailing & Subscriptions".message_categories.id
"Mailing & Subscriptions".subscription_unsubscribe_tokens.subscription_id -> "Mailing & Subscriptions".subscriptions.id
"Mailing & Subscriptions".message_category_topics.category_id -> "Mailing & Subscriptions".message_categories.id
"Mailing & Subscriptions".message_category_topics.topic_id -> "Mailing & Subscriptions".topics.id

"MTA Audit & Processing".mail_message.sender_account_id -> "User Management & Auth".account.id
"MTA Audit & Processing".received_message.mail_message_id -> "MTA Audit & Processing".mail_message.id
"MTA Audit & Processing".received_message.category_id -> "Mailing & Subscriptions".message_categories.id

"Delivery Pipeline".mail_ingress.mail_message_id -> "MTA Audit & Processing".mail_message.id
"Delivery Pipeline".mail_ingress.category_id -> "Mailing & Subscriptions".message_categories.id
"Delivery Pipeline".mail_delivery_pending.ingress_id -> "Delivery Pipeline".mail_ingress.id
"Delivery Pipeline".mail_delivery_claimed.id -> "Delivery Pipeline".mail_delivery_pending.id
"Delivery Pipeline".mail_delivery_done.ingress_id -> "Delivery Pipeline".mail_ingress.id
"Delivery Pipeline".mail_delivery_events.delivery_id -> "Delivery Pipeline".mail_delivery_pending.id
