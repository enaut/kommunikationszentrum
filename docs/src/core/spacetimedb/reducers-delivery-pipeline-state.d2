direction: right

JmapDeliveryLifecycle: {
  pending -> importing: "scheduled JMAP dispatch"
  importing -> pending: "retryable import failure"
  importing -> imported: "Email imported to Stalwart outbox"
  importing -> failed: "permanent import failure"
  imported -> submitting: "JMAP submission"
  submitting -> sent: "submission accepted"
  submitting -> submission_unknown: "submission outcome uncertain"
  submitting -> failed: "permanent submission failure"
  submission_unknown -> sent: "reconciliation finds accepted submission"
  submission_unknown -> submitting: "reconciliation finds no accepted submission"
  failed -> pending: "admin retry without imported Email ID"
  failed -> submission_unknown: "admin retry with imported Email ID"
}
