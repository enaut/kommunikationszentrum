direction: right

delivery: "Claimed Delivery\n(ingress.topic_id)"

resolve: "resolve_topic_smtp_credentials()" {
  shape: diamond
}

tables: "SpacetimeDB Tables" {
  topic: "visible_message_topics\n(app_password_id, email_address)"
  pass: "visible_topic_app_passwords\n(secret)"
}

cache: "transports Cache\nHashMap<u64, AsyncSmtpTransport>" {
  shape: cylinder
}

send: "transport.send_raw().await\n(Reused TLS connection pool)"

delivery -> resolve
resolve -> tables.topic: "Lookup topic"
tables.topic -> tables.pass: "Lookup secret"
tables.pass -> cache: "Get or build transport"
cache -> send: "Dispatch email"

