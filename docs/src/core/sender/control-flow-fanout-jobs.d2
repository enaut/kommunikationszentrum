direction: down

entry: "process_fanout_jobs()" { style.fill: "#fff9c4" }
owned: "self_owned_ingress_jobs()\nFilter local cache for rows where:\nclaim.claim_owner == self &&\nclaim.instance_id == current_uuid" {
  shape: diamond
  style.fill: "#ffffff"
}
claim: "claim_next_mail_ingress(instance_id)\n(Server atomically leases 1 pending/expired ingress)" { style.fill: "#bbdefb" }
wait50: "sleep 50 ms\n(Yield to allow background pump\nto receive updated row)" { style.fill: "#fff9c4" }
recheck: "Re-check self_owned_ingress_jobs()" {
  shape: diamond
  style.fill: "#ffffff"
}
none: "No ingress jobs available\nBreak fanout loop" { style.fill: "#ffcdd2" }
proc: "process_ingress_job(job)" { style.fill: "#bbdefb" }
err: "retry_mail_ingress(error)\n(Increments attempt count & schedules back-off)" { style.fill: "#ffe0b2" }
cont: "Continue loop to process next job\n(did_work = true)" { style.fill: "#c8e6c9" }

entry -> owned
owned -> claim: "None owned yet"
owned -> proc: "Owned job found"
claim -> wait50
wait50 -> recheck
recheck -> none: "Still empty"
recheck -> proc: "Leased job confirmed"
proc -> err: "Err(e)"
proc -> cont: "Ok(())"
err -> cont
cont -> owned
