direction: right

classes: {
  db_node: {
    shape: cylinder
    style: {
      fill: "#e3f2fd"
      stroke: "#1565c0"
    }
  }
  worker_node: {
    shape: rectangle
    style: {
      fill: "#f3e5f5"
      stroke: "#7b1fa2"
    }
  }
  ext_node: {
    shape: cloud
    style: {
      fill: "#fff3e0"
      stroke: "#e65100"
    }
  }
}

server: "SpacetimeDB Server Module" {
  messages_tbl: "mail_messages\n[queue_id, body_raw]" { class: db_node }
  ingress_tbl: "mail_ingress\n[Status: Pending, Processing, ...]" { class: db_node }
  pending_tbl: "mail_delivery_pending\n[Queued Deliveries]" { class: db_node }
  claimed_tbl: "mail_delivery_claimed\n[Active Leases (5 min)]" { class: db_node }
  deliv_msg_tbl: "mail_delivery_messages\n[RFC 5322 Raw Payloads]" { class: db_node }
  temp_fail_tbl: "mail_delivery_temporary_failed\n[Transient Failures (5 min backoff)]" { class: db_node }
  done_tbl: "mail_delivery_done\n[Sent / Failed / Bounced]" { class: db_node }
  events_tbl: "mail_delivery_events\n[Audit Trail]" { class: db_node }
  system_mail_tbl: "system_mail_pending\n[Verification / System Mails]" { class: db_node }
}

sender: "Sender Daemon (Async Tokio Runtime)" {
  pump: "Background DB Thread Pump\n(connection.run_threaded())" { class: worker_node }
  callbacks: "Table Subscription Callbacks\n(on_insert / on_update / on_delete)" { class: worker_node }
  channel: "Event Wakeup Channel\n(mpsc::unbounded_channel)" {
    shape: diamond
    style.fill: "#c8e6c9"
  }
  
  work_loop: "Main Reactive Work Loop" {
    fanout: "Fan-Out Engine\n(process_fanout_jobs)" { class: worker_node }
    system_mail: "System Mail Engine\n(send_system_mail_jobs)" { class: worker_node }
    delivery: "Delivery Engine\n(send_delivery_jobs)" { class: worker_node }
  }
}

ext: "External Services" {
  smtp: "Outbound SMTP Relay\n(Stalwart / SMTP2GO / Postfix)" { class: ext_node }
  otel: "Grafana Alloy / Tempo / Loki\n(OTLP Traces + Logs)" { class: ext_node }
}

server.ingress_tbl -> sender.pump: "WebSocket Subscription Stream"
server.pending_tbl -> sender.pump
server.claimed_tbl -> sender.pump
server.messages_tbl -> sender.pump
server.deliv_msg_tbl -> sender.pump
server.system_mail_tbl -> sender.pump

sender.pump -> sender.callbacks: "Local Cache Updates"
sender.callbacks -> sender.channel: "Event::Wakeup"
sender.channel -> sender.work_loop.fanout: "Wake Loop"
sender.work_loop.fanout -> sender.work_loop.system_mail: "Sequential Sweep"
sender.work_loop.system_mail -> sender.work_loop.delivery: "Sequential Sweep"

sender.work_loop.fanout -> server.pending_tbl: "enqueue_mail_delivery()"
sender.work_loop.system_mail -> server.system_mail_tbl: "claim / complete / release"
sender.work_loop.system_mail -> ext.smtp: "Send System Email"
sender.work_loop.delivery -> server.claimed_tbl: "claim_next_mail_delivery()"
sender.work_loop.delivery -> ext.smtp: "Send RFC 5322 Raw Message"
sender.work_loop.delivery -> server.done_tbl: "mark_sent() / fail_delivery()"
sender.work_loop.delivery -> server.temp_fail_tbl: "schedule_mail_delivery_retry()"
sender.work_loop.delivery -> server.events_tbl: "Log Delivery Event"

sender -> ext.otel: "OTLP Spans & Structured Logs"
