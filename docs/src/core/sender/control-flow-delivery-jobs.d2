direction: down

entry: "send_delivery_jobs()" { style.fill: "#fff9c4" }
owned: "self_owned_delivery_jobs()\nFilter sender_mail_delivery_claimed for:\nworker == self && instance_id == current_uuid" {
  shape: diamond
  style.fill: "#ffffff"
}
ret_none: "Return Ok(())\n(No claimed jobs currently owned)" { style.fill: "#c8e6c9" }

loop_: "For each claimed delivery" { style.fill: "#bbdefb" }
topic_check: "Lookup topic & credentials in cache\nresolve_topic_smtp_credentials(tid)" { shape: diamond }

pre_fail: "fail_mail_delivery()\n'smtp-transport-build'\n(Permanent pre-SMTP failure)" { style.fill: "#ffcdd2" }
cached: "Get or build AsyncSmtpTransport\n(Pooled per topic_id in HashMap)" { style.fill: "#bbdefb" }

send: "send_delivery(connection, transport, delivery, instance_id).await" { style.fill: "#c8e6c9" }
done: "Processed all owned deliveries\nReturn Ok(())" { style.fill: "#c8e6c9" }

entry -> owned
owned -> ret_none: "Empty"
owned -> loop_: "Owned delivery job(s)"

loop_ -> topic_check
topic_check -> pre_fail: "Missing credentials / bad TLS"
topic_check -> cached: "Valid credentials"
cached -> send
send -> loop_: "Next job"
loop_ -> done: "All finished"
