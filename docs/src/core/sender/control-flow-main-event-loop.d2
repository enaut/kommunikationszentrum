direction: down

fanout: "1. process_fanout_jobs()\n• Claim next ingress if none owned\n• Fan out owned ingress jobs" { style.fill: "#bbdefb" }
system_mail: "2. send_system_mail_jobs()\n• Claim unowned system mails (5 min lease)\n• Send verification / system emails\n• Complete or release claims" { style.fill: "#bbdefb" }
delivery: "3. send_delivery_jobs()\n• Resolve category SMTP credentials\n• Dispatch claimed deliveries over TLS" { style.fill: "#bbdefb" }
claim: "4. claim_next_mail_delivery()\nRequest next pending delivery claim" { style.fill: "#bbdefb" }

wait: "5. tokio::select!\n(Event Multiplexer)" {
  shape: diamond
  style.fill: "#fff9c4"
}

wakeup: "rx.recv() == Event::Wakeup\n(Table insert / update notification)" { style.fill: "#c8e6c9" }
timer: "sleep(15s) timeout\n(Periodic safety poll)" { style.fill: "#fff9c4" }
fatal: "rx.recv() == Event::FatalError\n(e.g. unauthorized identity)" { style.fill: "#ffcdd2" }
term: "Exit daemon with error" { style.fill: "#d32f2f"; style.font-color: white }

fanout -> system_mail
system_mail -> delivery
delivery -> claim
claim -> wait

wait -> wakeup: "Reactive table update"
wait -> timer: "15-second tick"
wait -> fatal: "Fatal error"

wakeup -> fanout: "Run work cycle"
timer -> fanout: "Run work cycle"
fatal -> term
