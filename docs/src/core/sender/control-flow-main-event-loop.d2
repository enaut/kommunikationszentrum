direction: down

wait: "tokio::select!\n(Event Multiplexer)" {
  shape: diamond
  style.fill: "#fff9c4"
}
ctrl_c: "SIGINT / Ctrl+C\nGraceful Shutdown" { style.fill: "#ffcdd2" }
work: "notify.notified()\nDoorbell Triggered" { style.fill: "#c8e6c9" }

fanout: "process_fanout_jobs()\n(Ingress → Pending Deliveries)" { style.fill: "#bbdefb" }
delivery: "process_delivery_jobs()\n(Claimed Deliveries → SMTP)" { style.fill: "#bbdefb" }
more: "Did any work?\nnotify.notify_one()\n(Self-draining chain reaction)" {
  shape: diamond
  style.fill: "#c8e6c9"
}

wait -> ctrl_c: "Shutdown Signal"
wait -> work: "Database Change / Bootstrap"
work -> fanout
fanout -> delivery
delivery -> more
more -> wait: "No more work (idle)"
more -> work: "Work completed (drain next batch)"
