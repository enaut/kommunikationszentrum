direction: down

start: "process_subscription_job()" { style.fill: "#fff9c4" }
dup: "Check if delivery ID exists in\npending, claimed, or done tables" { shape: diamond }
skip: "Return DeliveryQueued\n(Idempotent skip)" { style.fill: "#c8e6c9" }

tok: "Lookup active_unsubscribe_tokens\nfor subscription.id" { shape: diamond }
req: "ensure_subscription_unsubscribe_token()\n→ Return AwaitingToken" { style.fill: "#ffe0b2" }

comp: "compose_delivery()\nBuild RFC 5322 raw message with\ncustom list headers & unsubscribe links" { style.fill: "#bbdefb" }
enq: "enqueue_mail_delivery() reducer\n→ Inserts into MailDeliveryPending" { style.fill: "#bbdefb" }
ret: "Return DeliveryQueued" { style.fill: "#c8e6c9" }

start -> dup
dup -> skip: "Already exists"
dup -> tok: "New delivery"
tok -> req: "Token missing"
tok -> comp: "Token present"
comp -> enq -> ret
