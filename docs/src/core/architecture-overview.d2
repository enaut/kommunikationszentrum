direction: down

external: "External Systems" {
  direction: right
  django: "Django\nOAuth + user sync" {
    style.fill: "#fff3c6"
  }
  stalwart: "Stalwart MTA\nSMTP + JMAP + domains" {
    style.fill: "#eaeaea"
  }
  relay: "Outbound SMTP relay" {
    shape: cloud
    style.fill: "#f2ebff"
  }
}

core: "Kommunikationszentrum" {
  direction: right
  admin: "Admin UI\nDioxus" {
    style.fill: "#dfeeff"
  }
  db: "SpacetimeDB\nDB + reducers + HTTP" {
    style.fill: "#ffd8d8"
  }
  sender: "Sender daemon\ndelivery + retry queue" {
    style.fill: "#dfffe9"
  }
}

retry: "Temporary failure queue" {
  style.fill: "#ffe8c6"
}

domains: "Domain registry\ncategory app passwords" {
  style.fill: "#f4e3ff"
}

core.admin <-> core.db: "live views\nand reducer calls" {
  style.stroke: "#3b82f6"
}
core.admin -> external.django: "OIDC / OAuth" {
  style.stroke: "#f59e0b"
}
external.django -> core.db: "user sync\ncategory subscriptions" {
  style.stroke: "#22c55e"
}
external.stalwart -> core.db: "MTA hooks\ndomain sync" {
  style.stroke: "#ef4444"
}
external.stalwart <-> core.db: "mailbox inventory\nmailbox credentials" {
  style.stroke: "#8b5cf6"
}
core.db -> core.sender: "delivery fan-out" {
  style.stroke: "#10b981"
}
core.db -> retry: "transient SMTP failures" {
  style.stroke: "#f97316"
}
retry -> core.sender: "requeue" {
  style.stroke: "#f97316"
}
core.sender -> external.stalwart: "submission via list SMTP auth" {
  style.stroke: "#14b8a6"
}
core.sender -> external.relay: "final SMTP delivery" {
  style.stroke: "#7c3aed"
}
core.db -> domains: "category and domain state" {
  style.stroke: "#a855f7"
}
domains -> core.sender: "per-list credentials" {
  style.stroke: "#a855f7"
}
