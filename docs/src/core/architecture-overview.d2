direction: down

external: "External Systems" {
  direction: right
  django: "Django\nOAuth + user sync" {
    style.fill: "#fff3c6"
  }
  stalwart: "Stalwart MTA\nSMTP + JMAP + domains" {
    style.fill: "#eaeaea"
  }
}

core: "Kommunikationszentrum" {
  direction: right
  admin: "Admin UI\nDioxus" {
    style.fill: "#dfeeff"
  }
  db: "SpacetimeDB\nDB + reducers + scheduled JMAP delivery" {
    style.fill: "#ffd8d8"
  }
}

domains: "Domain registry\ntopic app passwords" {
  style.fill: "#f4e3ff"
}

core.admin <-> core.db: "live views\nand reducer calls" {
  style.stroke: "#3b82f6"
}
core.admin -> external.django: "OIDC / OAuth" {
  style.stroke: "#f59e0b"
}
external.django -> core.db: "user sync\ntopic subscriptions" {
  style.stroke: "#22c55e"
}
external.stalwart -> core.db: "MTA hooks\ndomain sync" {
  style.stroke: "#ef4444"
}
external.stalwart <-> core.db: "mailbox inventory\nmailbox credentials" {
  style.stroke: "#8b5cf6"
}
core.db -> external.stalwart: "scheduled JMAP\nmessage submission" {
  style.stroke: "#10b981"
}
core.db -> domains: "topic and domain state" {
  style.stroke: "#a855f7"
}
